{
  "name": "nomad-court-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "node scripts/deploy.js",
    "test": "vitest run",
    "test:id-source": "node scripts/check_dispute_id_source.js",
    "test:payout": "node scripts/test_native_payout.js",
    "test:payout:static": "node scripts/check_steward_native_payout.js",
    "test:steward": "node scripts/check_steward_native_payout.js && node scripts/test_native_payout.js",
    "typecheck": "tsc -b",
    "test:flow": "node scripts/test_flow.js"
  },
  "dependencies": {
    "genlayer-js": "1.1.8",
    "lucide-react": "^0.424.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vercel/node": "^3.2.29",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vitest": "^2.1.9"
  }
}
